<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="296dp"
	android:layout_height="176dp"
	android:background="@drawable/widget_preview_wash"
	android:orientation="vertical"
	android:padding="12dp">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:background="@drawable/widget_preview_panel"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:padding="10dp">

		<ImageView
			android:layout_width="76dp"
			android:layout_height="76dp"
			android:background="@drawable/widget_preview_cover_art"
			android:importantForAccessibility="no" />

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:gravity="center_vertical"
			android:orientation="vertical"
			android:paddingStart="12dp"
			android:paddingEnd="0dp">

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:maxLines="1"
				android:text="Hyaline Wormhole"
				android:textColor="#FFFFFF"
				android:textSize="15sp"
				tools:ignore="HardcodedText" />

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:maxLines="1"
				android:text="Vitrified Entity"
				android:textColor="#BFFFFFFF"
				android:textSize="13sp"
				tools:ignore="HardcodedText" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:gravity="center"
				android:orientation="horizontal">

				<ImageView
					android:layout_width="22dp"
					android:layout_height="22dp"
					android:layout_marginEnd="14dp"
					android:background="@drawable/ic_previous"
					android:backgroundTint="#FFFFFF"
					android:importantForAccessibility="no" />

				<FrameLayout
					android:layout_width="34dp"
					android:layout_height="34dp"
					android:background="@drawable/widget_preview_play_circle">

					<ImageView
						android:layout_width="18dp"
						android:layout_height="18dp"
						android:layout_gravity="center"
						android:background="@drawable/ic_play"
						android:backgroundTint="#141218"
						android:importantForAccessibility="no" />
				</FrameLayout>

				<ImageView
					android:layout_width="22dp"
					android:layout_height="22dp"
					android:layout_marginStart="14dp"
					android:background="@drawable/ic_next"
					android:backgroundTint="#FFFFFF"
					android:importantForAccessibility="no" />
			</LinearLayout>
		</LinearLayout>
	</LinearLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:orientation="horizontal">

		<ImageView
			android:layout_width="0dp"
			android:layout_height="48dp"
			android:layout_weight="1"
			android:background="@drawable/widget_preview_tile"
			android:backgroundTint="#4F86C6"
			android:importantForAccessibility="no" />

		<ImageView
			android:layout_width="0dp"
			android:layout_height="48dp"
			android:layout_marginStart="8dp"
			android:layout_weight="1"
			android:background="@drawable/widget_preview_tile"
			android:backgroundTint="#8A6BC0"
			android:importantForAccessibility="no" />

		<ImageView
			android:layout_width="0dp"
			android:layout_height="48dp"
			android:layout_marginStart="8dp"
			android:layout_weight="1"
			android:background="@drawable/widget_preview_tile"
			android:backgroundTint="#D08A4A"
			android:importantForAccessibility="no" />

		<ImageView
			android:layout_width="0dp"
			android:layout_height="48dp"
			android:layout_marginStart="8dp"
			android:layout_weight="1"
			android:background="@drawable/widget_preview_tile"
			android:backgroundTint="#4FA88A"
			android:importantForAccessibility="no" />

		<ImageView
			android:layout_width="0dp"
			android:layout_height="48dp"
			android:layout_marginStart="8dp"
			android:layout_weight="1"
			android:background="@drawable/widget_preview_tile"
			android:backgroundTint="#C2557E"
			android:importantForAccessibility="no" />
	</LinearLayout>

</LinearLayout>
