# The Worbus Server's settings. Copy to .env (next to compose.yaml) and fill in.
# .env holds your Navidrome password: keep it to yourself.
#
# ─── Required ──────────────────────────────────────────────────────────────────
# Your Navidrome, as the container reaches it: a LAN address such as
# http://192.168.1.10:4533, or a container name on the same Docker network. The server
# refuses to start with these three example values left in.
NAVIDROME_URL=https://navidrome.example.com
# A Navidrome ADMIN account: the server's primary user, and the account lb-bot reads
# the library with.
NAVIDROME_USER=your-navidrome-username
NAVIDROME_PASSWORD=your-navidrome-password

# Everything below is optional. The server fills in what its two halves need from
# each other (the service secret, their addresses, the data paths under /data).

# ─── The server ────────────────────────────────────────────────────────────────
# The name the apps show for this server (1 to 40 characters).
# HUB_NAME=Worbus Server
# Away from home: the wss:// address your reverse proxy or tunnel sends to port 4790.
# Only wss:// (an https:// value is read as wss://). Unset, the apps work at home only.
# HUB_PUBLIC_URL=wss://worbus.example.org
# lb-bot's page behind a proxy or tunnel: the address the apps' "Open in lb-bot" opens.
# Unset, an app at home opens this server's address on port 8899.
# LBBOT_WEB_URL=https://lb.example.org

# ─── Listening and discovery ───────────────────────────────────────────────────
# Your ListenBrainz user: weekly playlists, fresh releases, listening history.
# LISTENBRAINZ_USER=
# Last.fm key: a second opinion for "Similar albums".
# LASTFM_API_KEY=
# AcoustID key: placement checks each song's fingerprint before filing it.
# ACOUSTID_API_KEY=
# Spotify app credentials: import public Spotify playlists (both or neither).
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# Your contact for MusicBrainz's API (defaults to the project's page).
# MBZ_CONTACT=you@example.org

# ─── AudioMuse-AI ──────────────────────────────────────────────────────────────
# Your AudioMuse-AI server and its API token: radio by sound, moods, Your mix.
# AUDIOMUSE_URL=http://192.168.1.10:8000
# AUDIOMUSE_TOKEN=

# ─── Downloading (Soulseek through slskd) ──────────────────────────────────────
# Downloading is on only with an slskd API key (slskd: Options > API Keys). Also mount
# slskd's download folder at /downloads in compose.yaml. Unset, the apps offer "Find it"
# links instead.
# SLSKD_URL=http://192.168.1.10:5030
# SLSKD_API_KEY=
