# Copy to .env and fill in. Used by docker run --env-file .env
# Required: HUB_TOKEN below, and the Navidrome service account (NAVIDROME_URL,
# HUB_ND_USER, HUB_ND_PASS, in the Navidrome section: uncomment and fill them in).
# The optional services' URLs (AudioMuse, the preview sidecar) are commented out, so
# a copy turns on nothing that is not there; uncomment each one once that service
# exists. LBBOT_URL is left on (see its section).
#
# Required. The hub refuses to start with this example value (or none): set your
# own, for example `openssl rand -hex 16`. It is the hub <-> lb-bot service secret,
# and the legacy shared credential of clients from before device sign-in.
HUB_TOKEN=change-me-to-a-long-random-secret
HUB_PORT=4790

# Plain-HTTP health endpoint (Docker HEALTHCHECK / uptime probes). Defaults to
# HUB_PORT+1 when unset.
HUB_HEALTH_PORT=4791

# Drop known devices not seen within this many days (at start and hourly; keeps the
# device picker from accreting stale entries). A device's sign-in goes with it, so
# 0 keeps every device AND every device sign-in forever. Unset or blank means 7.
HUB_DEVICE_TTL_DAYS=7

# Verbose per-frame diagnostic logging (ACT/REPORT/SESSION at ~1 Hz). Off by
# default; set to true only when debugging playback state.
HUB_DEBUG=false

# Navidrome — REQUIRED (since Worbus project 2). Devices sign in with their own
# Navidrome account against NAVIDROME_URL, and the hub runs as a Navidrome service
# account. HUB_ND_USER is the PRIMARY user: the state of a hub from before user spaces
# becomes theirs, and the play-queue mirror and Your mix (the Sonic Fingerprint) are
# theirs alone. Make it the same account as lb-bot's NAVIDROME_USER, and a Navidrome
# admin if you can: it re-reads the other users' admin flags (a non-admin keeps the
# flags users signed in with). Uncomment all three and fill them in: the hub refuses to
# start without them, and refuses these placeholders. They stay commented here because
# the AudioMuse proxy below passes HUB_ND_USER/HUB_ND_PASS on to AudioMuse.
# Changing HUB_ND_USER later moves the old primary user's state under `users` and
# brings the new one's to the top level (nothing is deleted).
# NAVIDROME_URL=https://navidrome.example.com
# HUB_ND_USER=your-navidrome-username
# HUB_ND_PASS=your-navidrome-password
HUB_MIRROR_PLAYQUEUE=true

# Clients from before device sign-in send HUB_TOKEN; while this is true the hub takes
# it as the primary user, so they keep working through the upgrade. Set it false once
# every client signs in (packaging for other people's servers does). lb-bot's pushes
# into the hub keep using HUB_TOKEN either way.
HUB_ACCEPT_SHARED_TOKEN=true

# AudioMuse-AI core (Tier 2), proxied on /sonic/* over HUB_PORT so the clients
# never hold this URL, this token, or the Navidrome password. Leave AUDIOMUSE_URL
# unset to disable the proxy (clients then fall back to their own direct config,
# or to Tier 1). The proxy also refuses to run when HUB_TOKEN is empty.
# Uncomment to turn on the /sonic/* proxy, AudioMuse-ranked stations and moods.
# With HUB_ND_USER and HUB_ND_PASS set (above), the proxy passes them on to
# AudioMuse for the routes that read Navidrome play history (Your mix).
# AUDIOMUSE_URL=http://audiomuse:8000
AUDIOMUSE_TOKEN=your-audiomuse-api-token

# Stations (radio and autoplay computed by the hub, PROTOCOL.md §18) need AUDIOMUSE_URL,
# or the Navidrome creds above for the Tier 1 fallback alone. Their play history (ids,
# times and hashed title keys) is kept in <HUB_STATE>.history; 0 keeps it in memory
# only, so a restart forgets what was played.
HUB_STATION_HISTORY=1

# lb-bot (library-gap intelligence), proxied on /lb/* over HUB_PORT, so it is
# reached from a phone off the LAN through the hub's whitelist and never directly.
# The hub calls it with `Authorization: Bearer <HUB_TOKEN>`: lb-bot (from Worbus P1,
# 2026-10-28, which puts its web UI and API behind the Navidrome login) accepts that
# bearer as its trusted service caller, so lb-bot's LB_BOT_HUB_TOKEN must be this
# hub's HUB_TOKEN. An older lb-bot has no authentication at all and ignores it.
# Leave LBBOT_URL unset to disable — the clients then hide the discography /
# missing-album surfaces entirely. Like the AudioMuse proxy, it refuses to run when
# HUB_TOKEN is empty.
# Left on, unlike the services above: lb-bot ships with the hub in the Worbus Server.
# If you run no lb-bot, comment it out; left set, every /lb/* route answers unreachable.
LBBOT_URL=http://lb-bot:8899
# Optional: the address a PERSON opens lb-bot's web UI at, handed to the clients as
# `webUrl` for their "Open in lb-bot" links. Unset, it falls back to LBBOT_URL — right
# on a LAN install, but a Docker-internal name like the one above opens nowhere from a
# phone. Only an http(s) URL is passed on.
# LBBOT_WEB_URL=http://192.168.1.10:8899

# The reverse direction is configured on lb-bot, not here, and is REQUIRED since
# Worbus P1: set LB_BOT_HUB_URL to this hub's http:// address and LB_BOT_HUB_TOKEN
# to the same HUB_TOKEN (one shared secret for both directions). lb-bot then POSTs
# /lb/notify when an album lands, /lb/fill as a fill moves and /lb/index as its
# index moves (with its first-run build's progress, the clients' Home bar). Without
# them there is no index progress and Scan now waits for the 15-minute mirror pull,
# and an lb-bot behind its login refuses this hub's calls. lb-bot names the missing
# ones in its start-up log. When updating, deploy lb-bot first, then the hub, then the
# clients (Worbus project 2): a hub in front of an lb-bot too old to read who is calling
# serves only the primary user's lb calls (503 lbbot_too_old for everyone else).

# yt-dlp preview sidecar ("what does this album I don't own sound like"),
# proxied on /preview/* over HUB_PORT. The hub carries only the CONTROL plane —
# /preview/resolve and /preview/status, ordinary buffered JSON. The AUDIO never
# passes through this process: clients fetch it from the sidecar directly. That
# is a decision, not an omission; see PROTOCOL.md §16 and the PreviewProxy
# docstring for the measurements behind it.
#
# PREVIEW_URL is how the HUB reaches the sidecar (an internal Docker hostname is
# normal). Leave unset to disable — the clients then hide previews entirely.
# Uncomment to turn on /preview/* and the clients' previews (needs PREVIEW_SECRET
# below; the hub refuses to start with PREVIEW_URL set and that secret empty or
# still the example value).
# PREVIEW_URL=http://navi-connect-preview:4792

# PREVIEW_PUBLIC_URL is how a CLIENT, or a CHROMECAST, reaches it. In practice
# this is NOT optional, and the reason is worth reading: when it is unset the hub
# falls back to signing PREVIEW_URL, which is normally a Docker-internal name
# that NO client can resolve. So the fallback only does anything if you set
# PREVIEW_URL to a LAN address instead, and even then it covers only devices on
# that LAN -- a phone on mobile data and a Chromecast are both out.
#
# Unset also means the hub advertises previewCastable=false, and both clients
# then refuse a cast transfer while a preview is queued rather than letting it
# fail as silence at the speaker.
# Uncomment to let a phone off the LAN and a Chromecast play previews
# (previewCastable=true).
# PREVIEW_PUBLIC_URL=https://preview.example.com

# The stream-URL capability secret. MUST match the sidecar's PREVIEW_SECRET, and
# must NOT be HUB_TOKEN: a Chromecast sends no headers, so this credential lives
# in a URL, and HUB_TOKEN is the whole administrative surface of this hub. This
# one authorises exactly one thing — reading one `ext:` id's audio until `exp`.
# Read only when PREVIEW_URL is set, and then required: the hub refuses to start
# when it is empty or still this example value (an unsignable stream URL would
# fail at playback rather than at configuration).
PREVIEW_SECRET=change-me-to-a-different-long-random-secret

# How long a minted stream URL stays valid, in seconds. Default 6 h.
PREVIEW_TTL=21600
