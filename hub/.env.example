# Copy to .env and fill in. Used by docker run --env-file .env
HUB_TOKEN=change-me-to-a-long-random-secret
HUB_PORT=4790

# Plain-HTTP health endpoint (Docker HEALTHCHECK / uptime probes). Defaults to
# HUB_PORT+1 when unset.
HUB_HEALTH_PORT=4791

# Drop known devices not seen within this many days when the hub starts (keeps the
# device picker from accreting stale entries). 0 = keep every device forever.
HUB_DEVICE_TTL_DAYS=0

# Verbose per-frame diagnostic logging (ACT/REPORT/SESSION at ~1 Hz). Off by
# default; set to true only when debugging playback state.
HUB_DEBUG=false

# Navidrome — for the optional savePlayQueue mirror (lets unmodified Subsonic
# clients resume where you left off). Mirror is single-user, so give it creds.
NAVIDROME_URL=https://navidrome.example.com
HUB_MIRROR_PLAYQUEUE=true
HUB_ND_USER=your-navidrome-username
HUB_ND_PASS=your-navidrome-password

# AudioMuse-AI core (Tier 2), proxied on /sonic/* over HUB_PORT so the clients
# never hold this URL, this token, or the Navidrome password. Leave AUDIOMUSE_URL
# unset to disable the proxy (clients then fall back to their own direct config,
# or to Tier 1). The proxy also refuses to run when HUB_TOKEN is empty.
AUDIOMUSE_URL=http://audiomuse:8000
AUDIOMUSE_TOKEN=your-audiomuse-api-token

# lb-bot (library-gap intelligence), proxied on /lb/* over HUB_PORT. Its own API
# has no authentication and binds 0.0.0.0:8899, so this is the only safe way to
# reach it from a phone off the LAN. Leave LBBOT_URL unset to disable — the
# clients then hide the discography / missing-album surfaces entirely. Like the
# AudioMuse proxy, it refuses to run when HUB_TOKEN is empty.
LBBOT_URL=http://lb-bot:8899

# The reverse direction is configured on lb-bot, not here: set LB_BOT_HUB_URL to
# this hub's http:// address and LB_BOT_HUB_TOKEN to the same HUB_TOKEN, and
# lb-bot will POST /lb/notify when an album lands so every connected client
# refreshes. Optional — without it clients still pick the change up on their next
# read, just not while a page is already open.

# yt-dlp preview sidecar ("what does this album I don't own sound like"),
# proxied on /preview/* over HUB_PORT. The hub carries only the CONTROL plane —
# /preview/resolve and /preview/status, ordinary buffered JSON. The AUDIO never
# passes through this process: clients fetch it from the sidecar directly. That
# is a decision, not an omission; see PROTOCOL.md §16 and the PreviewProxy
# docstring for the measurements behind it.
#
# PREVIEW_URL is how the HUB reaches the sidecar (an internal Docker hostname is
# normal). Leave unset to disable — the clients then hide previews entirely.
PREVIEW_URL=http://navi-connect-preview:4792

# PREVIEW_PUBLIC_URL is how a CLIENT, or a CHROMECAST, reaches it. Not the same
# address, and not optional if you want previews to cast: a speaker fetches the
# stream URL itself and cannot route to a Docker-internal name. Unset means the
# hub advertises previewCastable=false and both clients refuse a cast transfer
# while a preview is queued, rather than letting it fail as silence.
PREVIEW_PUBLIC_URL=https://preview.example.com

# The stream-URL capability secret. MUST match the sidecar's PREVIEW_SECRET, and
# must NOT be HUB_TOKEN: a Chromecast sends no headers, so this credential lives
# in a URL, and HUB_TOKEN is the whole administrative surface of this hub. This
# one authorises exactly one thing — reading one `ext:` id's audio until `exp`.
# Unset disables the proxy (an unsignable stream URL would fail at playback
# rather than at configuration).
PREVIEW_SECRET=change-me-to-a-different-long-random-secret

# How long a minted stream URL stays valid, in seconds. Default 6 h.
PREVIEW_TTL=21600
