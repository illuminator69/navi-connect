# Copy to .env and fill in. Used by docker run --env-file .env

PREVIEW_PORT=4792

# The stream-URL capability secret. MUST be the same value as the hub's
# PREVIEW_SECRET, and must NOT be HUB_TOKEN.
#
# /stream is authorised by an HMAC in the URL rather than by a header, because a
# Chromecast fetches the URL itself and sends none. HUB_TOKEN is the hub's entire
# administrative surface and must never appear in a URL; this secret authorises
# exactly one thing — reading one `ext:` id's audio until its `exp`.
#
# The sidecar refuses to start without it: an unsigned /stream is an open media
# relay pointed at a third-party extractor.
PREVIEW_SECRET=change-me-to-a-long-random-secret-that-is-not-the-hub-token

# How far a candidate's length may differ from the track that was asked for
# before it is rejected whatever its title says (an album rip, an extended edit,
# a different recording). Only applied when the caller sends durationMs.
PREVIEW_DURATION_TOLERANCE_MS=20000

# Below this match confidence the answer is `{}` — "no preview found", which is a
# legitimate 200 and not an error. A wrong preview is worse than none.
PREVIEW_MIN_CONFIDENCE=0.45

# Concurrency. Extractions and streams are counted separately on purpose: an
# extraction is a burst of upstream requests, a stream is a long idle relay.
PREVIEW_MAX_EXTRACTIONS=3
PREVIEW_MAX_STREAMS=8

# How long a direct media URL is remembered. Shorter than a resolution because
# those URLs are themselves signed upstream and expire; serving an expired one
# reads to the user as a track that plays for zero seconds.
PREVIEW_MEDIA_TTL=1800

# A Netscape-format cookies.txt for the extractor. This is how yt-dlp answers
# "Sign in to confirm you're not a bot", which is what a challenged egress
# address gets. Unset = no cookies, which is correct wherever the address is not
# being challenged.
#
# USE A THROWAWAY ACCOUNT. These cookies are bearer access to whatever account
# exported them, they sit unencrypted on the NAS, and yt-dlp traffic can get an
# account rate-limited or terminated.
#
# Bind-mount a DIRECTORY and point this at a file inside it, not at the file
# itself: replacing a bind-mounted file changes its inode and the container
# keeps the old one. The path is inside the container.
PREVIEW_COOKIES=/data/cookies.txt
